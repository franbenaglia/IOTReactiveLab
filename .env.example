# Copiar a .env (fuera del repo) y completar:   cp .env.example .env
# Generar contraseñas:                          openssl rand -base64 18

# ---- Mosquitto (ADR-007)
MQTT_PORT=1883
MQTT_BIND=0.0.0.0
MQTT_BACKEND_PASSWORD=
MQTT_SIMULATOR_PASSWORD=
MQTT_HEALTHCHECK_PASSWORD=
# Dispositivos físicos, "deviceId:clave" separados por coma. El deviceId es el
# usuario MQTT y debe coincidir con el del firmware (secrets.ini).
MQTT_DEVICE_CREDENTIALS=esp32-real-001:

# ---- PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=iotlab
POSTGRES_USER=iotlab
POSTGRES_PASSWORD=
